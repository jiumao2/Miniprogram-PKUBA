<!-- pages/knockout/knockout.wxml -->
<view class="page">
  <view class="page-header">
    <view class="selector-card">
      <text class="selector-card__label">比赛组别</text>
      <picker bindchange="selectGroup" range="{{allgroups}}" value="{{value}}">
        <view class="selector-card__value">
          <text>{{allgroups[value]}}</text>
          <text class="selector-card__arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <view wx:if="{{bracketRows.length}}" class="bracket-card">
    <text class="page-title bracket-title">淘汰赛对阵图</text>
    <view class="container">
      <block wx:for="{{bracketRows}}" wx:key="index" wx:for-item="row">
        <view class="row {{row.className}}">
          <block wx:for="{{row.lines}}" wx:key="className" wx:for-item="line">
            <view class="line {{line.className}}"></view>
          </block>

          <block wx:for="{{row.matches}}" wx:key="className" wx:for-item="match">
            <view class="table {{match.className}}">
              <view class="tablerow team-row">
                <view class="cell cell-left team-name">{{match.homeName || '待定'}}</view>
                <text class="cell cell-center versus">VS</text>
                <view class="cell cell-right team-name">{{match.awayName || '待定'}}</view>
              </view>
              <view class="tablerow score-row">
                <view class="cell cell-left score">{{match.homeScore === '' ? '-' : match.homeScore}}</view>
                <text class="cell cell-center score-separator">:</text>
                <view class="cell cell-right score">{{match.awayScore === '' ? '-' : match.awayScore}}</view>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty-card">
    <text class="page-title bracket-title">淘汰赛对阵图</text>
    <text class="empty-card__title">暂无对阵数据</text>
    <text class="empty-card__desc">可以切换组别后再查看。</text>
  </view>

  <view class="page-spacer"></view>

  <view class="fadeIn {{hideLoading ? 'fadeOut' : ''}}" wx:if="{{loading}}">
    <view class="weui-mask_transparent"></view>
    <view class="weui-toast">
      <view class="weui-primary-loading weui-primary-loading_transparent">
        <view class="weui-primary-loading__dot"></view>
      </view>
      <view class="weui-toast__content">加载中</view>
    </view>
  </view>
</view>
