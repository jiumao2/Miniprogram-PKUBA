<!--pages/scoretable/scoretable.wxml-->
<view class="score-page">
  <view class="filter-panel">
    <view class="weui-cell weui-cell_active weui-cell_select weui-cell_select-after filter-cell">
      <view class="weui-cell__hd">
        <label class="weui-label">比赛组别</label>
      </view>
      <view class="weui-cell__bd">
        <picker bindchange="bindPickerChange1" range="{{array1}}" value="{{value1}}">
          <view class="weui-select">{{array1[value1]}}</view>
        </picker>
      </view>
    </view>

    <view class="weui-cell weui-cell_active weui-cell_select weui-cell_select-after filter-cell">
      <view class="weui-cell__hd">
        <label class="weui-label">所在小组</label>
      </view>
      <view class="weui-cell__bd">
        <picker bindchange="bindPickerChange2" range="{{array2}}" value="{{value2}}">
          <view class="weui-select">{{array2[value2]}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="weui-form score-form">
    <view class="weui-form__text-area title-block">
      <h2 class="weui-form__title">{{group}}{{littlegroup}}组积分表</h2>
      <view class="weui-form__desc">表内第一个数字为行队得分</view>
    </view>

    <view wx:if="{{!loading && names.length}}" class="container">
      <scroll-view scroll-x class="table-scroll-wrap">
        <view class="table-scroll-inner">
          <view class="table-card">
            <view class="table">
              <view class="row">
                <view class="matrix-cell"></view>
                <view class="matrix-cell" wx:for="{{names}}" wx:key="*this">{{item}}</view>
              </view>

              <block wx:for="{{score}}" wx:for-index="i1" wx:for-item="s1">
                <view class="row">
                  <view class="matrix-cell">{{names[i1]}}</view>
                  <block wx:for="{{s1}}" wx:for-index="i2" wx:for-item="s2">
                    <view class="matrix-cell" wx:if="{{i1!=i2&&s2[0]>=0}}" style="color:{{s2[0]<s2[1]?'rgb(0, 0, 0)':'rgb(255, 72, 0)'}}">
                      <text class="scorecell">{{s2[0]}}:{{s2[1]}}</text>
                      <text>\n</text>
                      <text>{{s2[2]}}</text>
                    </view>
                    <view class="matrix-cell cell-diagonal" wx:if="{{i1==i2}}">\</view>
                    <view class="matrix-cell" wx:if="{{s2[0]<0}}"></view>
                  </block>
                </view>
              </block>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{!loading && !names.length}}" class="container">
      <view class="empty-card">当前小组暂无队伍数据</view>
    </view>

    <view class="container" wx:if="{{!loading}}">
      <view class="table-card summary-card">
        <view class="summary-title">排名总览</view>
        <view class="table">
          <view class="row">
            <text class="summary-cell">队伍</text>
            <text class="summary-cell">积分</text>
            <text class="summary-cell wide-cell">总净胜分</text>
            <text class="summary-cell">排名</text>
          </view>

          <block wx:for="{{teams}}" wx:key="name" wx:for-index="i1" wx:for-item="s1">
            <view class="row">
              <text class="summary-cell">{{s1.name}}</text>
              <text class="summary-cell">{{s1.grouppoint}}</text>
              <text class="summary-cell wide-cell">{{s1.groupnetscore}}</text>
              <text class="summary-cell">{{s1.grouppoint==0?(nonzero+1):(i1+1)}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view class="pad_down"></view>
  </view>
</view>

<view class="fadeIn {{hideLoading ? 'fadeOut' : ''}}" wx:if="{{loading}}">
  <view class="weui-mask_transparent"></view>
  <view class="weui-toast">
    <view class="weui-primary-loading weui-primary-loading_transparent">
      <view class="weui-primary-loading__dot"></view>
    </view>
    <view class="weui-toast__content">加载中...</view>
  </view>
</view>
