.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: linear-gradient(180deg, #fbfcfe 0%, #f4f7fb 100%);
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 1px solid rgba(108, 141, 181, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.page-title {
  color: #2f3a4a;
  font-size: 40rpx;
  font-weight: 700;
}

.selector-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1px solid rgba(108, 141, 181, 0.1);
}

.selector-card__label {
  color: #8a95a8;
  font-size: 24rpx;
}

.selector-card__value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #6c8db5;
  font-size: 28rpx;
  font-weight: 600;
}

.selector-card__arrow {
  color: #94a6bf;
  font-size: 20rpx;
}

.bracket-card,
.empty-card {
  padding: 24rpx 18rpx 28rpx;
  border: 1px solid rgba(108, 141, 181, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.03);
}

.bracket-title {
  display: block;
  margin-bottom: 22rpx;
  padding: 0 10rpx;
  text-align: center;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.page-spacer {
  height: 20px;
}

.row {
  position: relative;
  display: flex;
  width: 100%;
  height: 94rpx;
  align-items: center;
  text-align: center;
}

.row-short {
  height: 50rpx;
}

.line {
  position: absolute;
  background: #b8c2d1;
  border-radius: 999rpx;
  opacity: 0.78;
}

.line-v {
  width: 4rpx;
}

.line-h {
  height: 4rpx;
}

.line-left-30 {
  left: 30%;
}

.line-right-30 {
  right: 30%;
}

.line-left-35 {
  left: 35%;
}

.line-right-35 {
  right: 35%;
}

.line-mid-left {
  left: 50%;
}

.line-full {
  height: 100%;
}

.line-top-half {
  top: 50%;
  height: 50%;
}

.line-bottom-half {
  bottom: 50%;
  height: 50%;
}

.line-w-5 {
  width: 5%;
}

.line-w-15 {
  width: 15%;
}

.line-offset {
  margin-left: 1px;
}

.table {
  position: absolute;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 30%;
  height: 100%;
  border: 1px solid rgba(108, 141, 181, 0.1);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.025);
  box-sizing: border-box;
}

.table-left {
  left: 15%;
}

.table-right {
  right: 15%;
}

.table-center {
  left: 35%;
}

.table-single {
  left: 25%;
  width: 50%;
}

.table-final {
  left: 20%;
  width: 60%;
}

.tablerow {
  position: relative;
  display: flex;
  flex: 1;
  width: 100%;
  align-items: center;
  text-align: center;
}

.team-row {
  border-bottom: 1px solid rgba(108, 141, 181, 0.06);
}

.score-row {
  background: rgba(108, 141, 181, 0.035);
  border-bottom-left-radius: 22rpx;
  border-bottom-right-radius: 22rpx;
}

.cell {
  position: absolute;
  width: 36%;
  text-align: center;
}

.cell-left {
  left: 6%;
}

.cell-center {
  left: 41%;
  width: 18%;
}

.cell-right {
  right: 6%;
}

.team-name {
  color: #3d4756;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.versus {
  color: #a0aabd;
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.65;
}

.score,
.score-separator {
  color: #6c8db5;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  text-align: center;
}

.empty-card__title {
  color: #2f3a4a;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-card__desc {
  margin-top: 12rpx;
  color: #96a0af;
  font-size: 24rpx;
}
